# Zerodha Kite Connect API credentials (paid developer subscription on kite.trade)
KITE_API_KEY=your_api_key_here
KITE_API_SECRET=your_api_secret_here
# Cached daily access token (populated by `orion login`)
KITE_ACCESS_TOKEN=

# Anthropic API key for the reasoning modules
ANTHROPIC_API_KEY=your_anthropic_key_here

# Optional model overrides
ORION_MODEL=claude-sonnet-4-6
ORION_CIO_MODEL=claude-opus-4-8
